# ════════════════════════════════════════════════════════════
#  Korta AI: ALL configuration lives here.
#  Your own copy (.env) is created by: npm run setup
#  NEVER commit .env or show it on screen.
# ════════════════════════════════════════════════════════════

# ── Network (TESTNET ONLY) ─────────────────────────────────
STELLAR_NETWORK=stellar:testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# ── USDC (Circle testnet) ──────────────────────────────────
USDC_ASSET_CODE=USDC
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
USDC_DECIMALS=7
USDC_FAUCET_URL=https://faucet.circle.com

# ── Wallets (npm run setup fills these in) ─────────────────
# Korta's wallet: the shop's supplier float. It PAYS. Its USDC balance is the hard limit.
KORTA_AGENT_SECRET=
# Payees: each supplier and the market-data seller get paid into their own wallet.
# Secrets are kept only so you can manage received test funds; the app never uses them.
SUPPLIER_A_ADDRESS=
SUPPLIER_A_SECRET=
SUPPLIER_B_ADDRESS=
SUPPLIER_B_SECRET=
SUPPLIER_C_ADDRESS=
SUPPLIER_C_SECRET=
MARKET_ADDRESS=
MARKET_SECRET=

# ── Facilitator ────────────────────────────────────────────
# primary = Built on Stellar (OpenZeppelin), needs a free key · backup = Coinbase, testnet, no key
FACILITATOR=backup
FACILITATOR_PRIMARY_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_PRIMARY_API_KEY=
FACILITATOR_PRIMARY_KEY_URL=https://channels.openzeppelin.com/testnet/gen
FACILITATOR_BACKUP_URL=https://x402.org/facilitator

# ── Brain ──────────────────────────────────────────────────
# ai = an OpenAI model runs Korta · scripted = fixed decision rules, no AI (demo fallback)
KORTA_BRAIN=scripted
KORTA_MAX_STEPS=14
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Owner policy (enforced in code, never shown to the AI) ──
# Services Korta may pay, comma-separated host:port
KORTA_ALLOWED_HOSTS=localhost:4021
# Data purchases (quotes, demand signals): pay automatically up to this per request…
KORTA_DATA_MAX_PER_REQUEST_USD=0.01
# …and up to this in total per restock run
KORTA_DATA_BUDGET_PER_RUN_USD=0.05
# Supplier orders: always need the owner's approval, and never above this
KORTA_ORDER_MAX_USD=8
# Never let an order take the wallet below this
KORTA_CASH_RESERVE_USD=2
# Most Korta may spend per day, data + orders (USD)
KORTA_DAILY_BUDGET_USD=30
# How long to wait for the owner's answer before declining (seconds)
KORTA_APPROVAL_TIMEOUT_SECONDS=300
# Local record of payments (git-ignored)
KORTA_SPEND_LOG_FILE=.korta-spend-log.json

# ── Servers ────────────────────────────────────────────────
# Supplier Network (the x402 sellers)
PORT=4021
SUPPLIERS_BASE_URL=http://localhost:4021
# Korta console (the owner's dashboard)
CONSOLE_PORT=4022
# Lets the dashboard switch supplier scenarios (price jump, out of stock…). Demo/eval only.
KORTA_DEMO_CONTROLS=true
